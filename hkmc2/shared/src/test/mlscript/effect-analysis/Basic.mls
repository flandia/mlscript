//│ flow-analysis > access leaf_unsafe⁰ @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// * @pure overrides a getter's body effect.
module M with
  @pure fun leaf_pure = unsafe()
fun node_pure() = M.leaf_pure
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function node_pure⁰#0 @ <root> -> Pure
//│ flow-analysis > call unsafe@result⁰#0 @ <root> -> UnsafeEta
