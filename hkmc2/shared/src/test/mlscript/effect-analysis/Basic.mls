// * Getter effects remain separate through polymorphic calls.
fun answer() = 42
fun apply(f) = f()
module M with
  fun leaf_pure = apply(answer)
  fun leaf_unsafe = apply(unsafe)
fun node_pure() = M.leaf_pure
fun node_unsafe() = M.leaf_unsafe
