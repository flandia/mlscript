// * Methods & Constructors.
// * Methods are unsafe because it's unknwon in compilation time.
// * Constructors are unsafe because it's a limitation of the alaysis implementation.
// TODO: Refine the analysis?
class Box() with
  fun pure() = 42
  fun unsafe() = unsafe()
fun box_constructor() = Box()
fun box_instantiation() = new Box()
fun box_pure(box: Box) = box.pure()
fun box_unsafe(box: Box) = box.unsafe()
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function box_constructor⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function box_instantiation⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function box_pure⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function box_unsafe⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call pure@result²#0 @ <root> -> UnsafeEta
//│ flow-analysis > call unsafe@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > call unsafe@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// * Getters
module M with
  fun leaf_pure = 42
  fun leaf_unsafe = unsafe()
fun node_pure() = M.leaf_pure
fun node_unsafe() = M.leaf_unsafe
