// * Getter effects propagate through recursive functions.
module M with
  fun leaf_pure = node_pure()
  fun leaf_unsafe = node_unsafe()
fun node_pure() = M.leaf_pure
fun node_unsafe() = unsafe(); M.leaf_unsafe
