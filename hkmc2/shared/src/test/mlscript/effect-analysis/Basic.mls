//│ flow-analysis > access get² @ node_unsafe¹.get¹ -> UnsafeEta
//│ flow-analysis > access leaf_pure⁰ @ leaf_pure² -> Pure
//│ flow-analysis > access leaf_pure⁰ @ node_unsafe¹.leaf_pure¹ -> Pure
//│ flow-analysis > <<< effect-analysis results <<<
