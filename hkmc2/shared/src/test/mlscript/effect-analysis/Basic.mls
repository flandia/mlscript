#config(inlining: None, liftDefns: Some(LiftDefns), flowBasedOpt: Some(FlowBasedOpt(logEffects: true, mono: true)))
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<

open annotations { pure }
declare fun unsafe(): Anything
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<



// * Pure remains pure through calls
fun leaf_pure(x) = x + 42
fun node_pure(x) = leaf_pure(x)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function leaf_pure⁰#0 @ <root> -> Pure
//│ flow-analysis > function node_pure⁰#0 @ <root> -> Pure
//│ flow-analysis > call +⁰@result¹#0 @ <root> -> Pure
//│ flow-analysis > call leaf_pure⁰@result⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * They run in separate diff blocks, so the flow-analysis results of leaf
// * isn't available in node_value. Yet, node_value should be able to infer the
// * purity from the binding type (val) solely.
val leaf_pure = 42
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<
//│ leaf_pure = 42
//-
fun node_value() = leaf_pure
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function node_value⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Accessing a pattern is pure
pattern Leaf = 42
fun node_pattern() = Leaf
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function node_pattern⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Unsafe propagates through calls; unknown calls are unsafe.
fun leaf_unsafe(x) = unsafe()
fun node_unsafe(x) = leaf_unsafe(x)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function leaf_unsafe⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function node_unsafe⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call leaf_unsafe⁰@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call unsafe@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// * Unsafe propagates through calls; unknown calls are unsafe.
fun leaf_unsafe(x) = print(42)
fun node_unsafe(x) = leaf_unsafe(x)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function leaf_unsafe⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function node_unsafe⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call leaf_unsafe⁰@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call print@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<


// * Propagation through higher-order calls (monomorphic).
fun answer() = 42
fun leaf_pure_public(x) = x()
private fun leaf_pure_private(x) = x()
fun leaf_unsafe_public(x) = x()
private fun leaf_unsafe_private(x) = x()
fun node() = 
  leaf_pure_public(answer)
  leaf_pure_private(answer)
  leaf_unsafe_public(unsafe)
  leaf_unsafe_private(unsafe)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function answer⁰#0 @ <root> -> Pure
//│ flow-analysis > function leaf_pure_private⁰#0 @ <root> -> Pure
//│ flow-analysis > function leaf_pure_public⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function leaf_unsafe_private⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function leaf_unsafe_public⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function node⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call leaf_pure_private⁰@result²#0 @ <root> -> Pure
//│ flow-analysis > call leaf_pure_public⁰@result³#0 @ <root> -> UnsafeEta
//│ flow-analysis > call leaf_unsafe_private⁰@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call leaf_unsafe_public⁰@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > call x²@result⁶#0 @ <root> -> Pure
//│ flow-analysis > call x³@result⁷#0 @ <root> -> UnsafeEta
//│ flow-analysis > call x¹@result⁵#0 @ <root> -> UnsafeEta
//│ flow-analysis > call x⁰@result⁴#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<

// * Recursive calls propagate pure and unsafe.
fun node_recursive_pure() = node_recursive_pure()
fun node_recursive_unsafe() = unsafe(); node_recursive_unsafe()
