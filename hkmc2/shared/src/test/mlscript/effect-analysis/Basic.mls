//│ flow-analysis > <<< effect-analysis results <<<


// * @pure is also trusted for getters from an earlier block.
fun node_pure() = M.leaf_pure
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function node_pure⁰#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Returning a function does not execute its body.
module M with
  fun leaf_pure = () => unsafe()
fun node_pure() = M.leaf_pure
fun node_unsafe() = M.leaf_pure()
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function lambda⁰#0 @ <root> -> UnsafeEta
