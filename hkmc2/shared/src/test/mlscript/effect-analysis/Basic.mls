//│ flow-analysis > call unsafe@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > access leaf_pure⁰ @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<


// * Spreading is conservatively unsafe.
@pure
fun leaf_pure_1(...xs) = unsafe()
fun leaf_pure_2(...xs) = 42
fun node_pure_1(xs) = leaf_pure_1(...xs)
fun node_pure_2(xs) = leaf_pure_2(...xs)
fun node_pure_3(xs) = leaf_pure_1(1, 2, 3)
fun node_pure_4(xs) = leaf_pure_2(1, 2, 3)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function leaf_pure_1⁰#0 @ <root> -> Pure
//│ flow-analysis > function leaf_pure_2⁰#0 @ <root> -> Pure
//│ flow-analysis > function node_pure_1⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function node_pure_2⁰#0 @ <root> -> UnsafeEta
