// * A pure getter does not suppress effects from its qualifier.
fun node_unsafe() = N.get.leaf_pure
module N with
  fun get: module M = unsafe(); M
module M with
  @pure fun leaf_pure = 42
//│ flow-analysis > >>> effect-analysis results >>>
